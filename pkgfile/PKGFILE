pkgname=voidbr-grub-theme
pkgdesc="Void theme for grub"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(grub grub-utils grub-x86_64-efi grub-terminus grub-btrfs grub-btrfs-runit)

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
	install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
	install=pkgfile.install
fi

package() {
	cd "${srcdir}/${pkgname}"

	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	else
		InternalDir="${srcdir}/${pkgname}"
	fi

	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("usr" "etc" "opt" "boot")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	[ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	# Install documentation if present
	[ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	if [ -n "${MKISO_BUILD:-}" ]; then
		echo "${YELLOW}[-]${RESET} Build de ISO detectado (MKISO_BUILD) — pulando."
		return 0
	fi

	if [ -z "${VOIDBR_INSTALLER:-}" ]; then
		if grep -q '^GRUB_THEME=' /etc/default/grub; then
			sed -i 's|^GRUB_THEME=.*|GRUB_THEME="/boot/grub/themes/voidbr/theme.txt"|' /etc/default/grub
		else
			echo 'GRUB_THEME="/boot/grub/themes/voidbr/theme.txt"' >>/etc/default/grub
		fi
	fi

	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}
